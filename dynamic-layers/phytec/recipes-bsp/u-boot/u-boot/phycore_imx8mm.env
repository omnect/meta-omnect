console=ttymxc2,115200
fdt_addr=0x48000000
kernel_addr_r=0x80280000
pxefile_addr_r=0x4f800000
ramdisk_addr_r=0x49200000
scriptaddr=0x49100000

/*
 * Keep the DTB and initrd in the low 1 GiB of DRAM.
 *
 * Previously, U-Boot's boot_fdt_high()/boot_ramdisk_high() relocated the DTB
 * and initrd to the top of RAM (observed at ~0xbae14000 / ~0xbae26000), which
 * lies inside the kernel's linux,cma window (alloc-ranges 0x80000000-0xc0000000
 * on this 2 GiB board). That reserved boot payload capped top-down CMA
 * placement, forcing the 640 MiB CMA pool up to 0x92e00000-0xbae00000 - directly
 * on top of the ramoops region at 0xb0000000 when it was enabled.
 *
 * fdt_high/initrd_high disable relocation so the payload stays at fdt_addr /
 * ramdisk_addr_r (both < 0x50000000, well outside the CMA window). bootm_size
 * additionally caps the relocation ceiling to the low 1 GiB (bootm_low is the
 * 0x40000000 DRAM base) as a backstop. These live in the compiled default env,
 * so they survive omnect_update_flow's per-boot saveenv.
 */
fdt_high=0xffffffffffffffff
initrd_high=0xffffffffffffffff
bootm_size=0x40000000

#include <env/omnect_env.env>
boot_scripts=fdt-load.scr boot.scr
distro_bootcmd=mmc dev ${mmcdev};if mmc rescan; then setenv devnum ${mmcdev}; devtype=mmc; run scan_dev_for_scripts;fi
