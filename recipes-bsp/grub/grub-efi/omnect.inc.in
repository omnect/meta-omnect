if [ "x${omnect_os_bootpart}" = "x" ]; then
  set omnect_os_bootpart=2
  save_env omnect_os_bootpart
fi

if [ "x${omnect_validate_update}" = "x" ]; then
  if [ "x${omnect_validate_update_part}" = "x" ]; then
    echo "Normal boot - booting from partition ${omnect_os_bootpart}"
  else
    echo "Update in progress - booting from partition ${omnect_validate_update_part}"
    set omnect_validate_update=1
    save_env omnect_validate_update
    set omnect_os_bootpart=${omnect_validate_update_part}
    if [ "x${omnect_validate_extra_bootargs}" != "x" ]; then
      if [ "${omnect_validate_extra_bootargs}" = "#noargs" ]; then
        unset omnect_extra_bootargs
      else
        set omnect_extra_bootargs="${omnect_validate_extra_bootargs}"
      fi
    fi
    # no save_env omnect_os_bootpart + omnect_extra_bootargs here!
  fi
else
  echo "Update validation failed - booting from partition ${omnect_os_bootpart}"
  set omnect_validate_update_part=
  save_env omnect_validate_update_part
  set omnect_validate_update=
  save_env omnect_validate_update
  set omnect_validate_extra_bootargs=
  save_env omnect_validate_extra_bootargs
  set omnect_validate_update_failed=1
  save_env omnect_validate_update_failed
fi

if [ "${default}" != "Certificate Provision" ]; then
  set default="omnect-os"
fi

menuentry 'omnect-os' --unrestricted {
    # boot from the disk GRUB was loaded from; hd0 can be another disk
    if ! regexp --set=1:omnect_disk '^\(([^,)]+)' "${cmdpath}"; then
        echo "No disk in cmdpath ${cmdpath}, using hd0"
        set omnect_disk=hd0
    fi
    set root=(${omnect_disk},gpt${omnect_os_bootpart})
    if ! probe --set=bootpart_fsuuid --fs-uuid (${omnect_disk},gpt1); then
        echo "Cannot read the filesystem UUID of (${omnect_disk},gpt1)"
        sleep 5
    fi
    linux /boot/bzImage rootpart=${omnect_os_bootpart} bootpart_fsuuid=${bootpart_fsuuid} ${omnect_extra_bootargs} @@OMNECT_APPEND_1ST_BOOT@@
    initrd /boot/initramfs.cpio.gz
}
